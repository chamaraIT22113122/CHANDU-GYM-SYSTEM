generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String           @id @default(uuid())
  email        String?          @unique
  membershipId String?          @unique
  password     String
  role         String           @default("MEMBER")
  firstName    String
  lastName     String
  phone        String?
  joinDate     DateTime         @default(now())
  specialCases String?
  injuries     String?
  dietAlerts   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  height       Float?
  targetWeight Float?
  nic          String?          @unique
  imageUrl     String?
  weight       Float?
  attendances  Attendance[]
  bookings     Booking[]
  dietPlans    DietPlan[]
  memberships  Membership[]
  payments     Payment[]
  metrics      PhysicalMetric[]
  workoutPlans WorkoutPlan[]
}

model Membership {
  id              String    @id @default(uuid())
  userId          String
  startDate       DateTime
  endDate         DateTime
  status          String    @default("ACTIVE")
  baseFee         Float
  maintenanceFee  Float     @default(3000.0)
  penaltyFee      Float     @default(0.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          String?
  packageDuration String?
  packageName     String?
  packageTime     String?
  user            User      @relation(fields: [userId], references: [id])
  payments        Payment[]
}

model Attendance {
  id       String    @id @default(uuid())
  userId   String
  checkIn  DateTime  @default(now())
  checkOut DateTime?
  user     User      @relation(fields: [userId], references: [id])
}

model PhysicalMetric {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @default(now())
  weight     Float?
  bodyFat    Float?
  muscleMass Float?
  user       User     @relation(fields: [userId], references: [id])
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  schedule    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model DietPlan {
  id        String   @id @default(uuid())
  userId    String
  title     String
  details   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  dayOfWeek String
  startTime String
  endTime   String
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String      @id @default(uuid())
  userId       String
  membershipId String?
  amount       Float
  method       String
  status       String      @default("COMPLETED")
  description  String?
  date         DateTime    @default(now())
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GymPlan {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  registrationFee Float    @default(0)
  duration        String
  features        String
  isPopular       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
